<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_workover" model="ir.module.category">
        <field name="name">Workover Operations</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_workover_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_workover"/>
    </record>

    <record id="group_workover_rig_summary" model="res.groups">
        <field name="name">Rig Summary</field>
        <field name="category_id" ref="module_category_workover"/>
        <field name="implied_ids" eval="[(4, ref('group_workover_user'))]"/>
        <field name="comment">Access the Rig Summary Report tab on daily reports.</field>
    </record>

    <record id="group_workover_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_workover"/>
        <field name="implied_ids" eval="[(4, ref('group_workover_user')), (4, ref('group_workover_rig_summary'))]"/>
    </record>

    <!-- Multi-company: each user sees only reports of allowed companies -->
    <record id="rule_workover_daily_report_company" model="ir.rule">
        <field name="name">Workover Daily Report: multi-company</field>
        <field name="model_id" ref="model_workover_daily_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_workover_rig_summary_company" model="ir.rule">
        <field name="name">Workover Rig Summary: multi-company</field>
        <field name="model_id" ref="model_workover_rig_summary"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
