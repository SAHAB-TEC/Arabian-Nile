<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_workover_rig_summary_wizard_form" model="ir.ui.view">
        <field name="name">workover.rig.summary.wizard.form</field>
        <field name="model">workover.rig.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Rig Summary Report" create="0" delete="0" edit="1">
                <header>
                    <button name="action_print_pdf"
                            type="object"
                            string="Print PDF"
                            class="btn-secondary"
                            icon="fa-print"/>
                    <button name="action_export_xlsx"
                            type="object"
                            string="Export Excel"
                            class="btn-primary"
                            icon="fa-file-excel-o"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Rig Summary Report</h1>
                    </div>
                    <group>
                        <group string="Period">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Filters">
                            <field name="rig_id" required="1" options="{'no_create': True}"/>
                            <field name="operator_id" options="{'no_create': True}"/>
                            <field name="well_id"
                                   domain="[('rig_id', '=', rig_id)]"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Totals">
                        <group>
                            <field name="total_full_ops" string="Full Ops Hrs" readonly="1"/>
                            <field name="total_standby_wcrew" string="Stand-By W/Crew" readonly="1"/>
                            <field name="total_standby_wocrew" string="Stand-By W-O/Crew" readonly="1"/>
                            <field name="total_full_repair" string="Full Repair Rate" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_zero_rate" string="Zero Rate" readonly="1"/>
                            <field name="total_force_majeure" string="Force Majeure" readonly="1"/>
                            <field name="total_rd_ru_rmtime" string="R/D, R/U &amp; R/MTime" readonly="1"/>
                            <field name="total_hours" string="Total Hours" readonly="1"/>
                        </group>
                    </group>
                    <field name="report_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="report_date"/>
                            <field name="well_id"/>
                            <field name="summary_full_ops" sum="Full Ops Hrs"/>
                            <field name="summary_standby_wcrew" sum="Stand-By W/Crew"/>
                            <field name="summary_standby_wocrew" sum="Stand-By W-O/Crew"/>
                            <field name="summary_full_repair" sum="Full Repair Rate"/>
                            <field name="summary_zero_rate" sum="Zero Rate"/>
                            <field name="summary_force_majeure" sum="Force Majeure"/>
                            <field name="summary_rd_ru_rmtime" sum="R/D, R/U &amp; R/MTime"/>
                            <field name="summary_total_hours" sum="Total"/>
                            <field name="summary_type"/>
                            <field name="operations_summary"/>
                            <field name="state" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_workover_rig_summary_wizard" model="ir.actions.act_window">
        <field name="name">Rig Summary Report</field>
        <field name="res_model">workover.rig.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_workover_rig_summary_wizard_form"/>
        <field name="target">current</field>
        <field name="groups_id" eval="[(4, ref('group_workover_rig_summary'))]"/>
    </record>
</odoo>
