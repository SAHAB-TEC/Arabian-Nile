<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_workover_daily_report_list" model="ir.ui.view">
        <field name="name">workover.daily.report.list</field>
        <field name="model">workover.daily.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="report_date"/>
                <field name="report_number"/>
                <field name="rig_id"/>
                <field name="well_id"/>
                <field name="operator_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="summary_type"/>
                <field name="time_breakdown_total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="view_workover_daily_report_form" model="ir.ui.view">
        <field name="name">workover.daily.report.form</field>
        <field name="model">workover.daily.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="report_date"/>
                            <field name="report_number"/>
                            <field name="rig_id"/>
                            <field name="well_id"/>
                            <field name="operator_id"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="spud_date"/>
                            <field name="release_date"/>
                            <field name="depth"/>
                            <field name="present_operation_title"/>
                            <field name="summary_type"/>
                            <field name="operations_summary"/>
                            <field name="time_breakdown_total" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Present Operations">
                            <field name="present_operation_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="time_from" widget="datetime_time"/>
                                    <field name="time_to" widget="datetime_time"/>
                                    <field name="type_category_id"/>
                                    <field name="operation_type" column_invisible="1"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Time Breakdown">
                            <div class="alert alert-info" role="alert">
                                Time breakdown is calculated automatically from Present Operations
                                (duration per line, grouped by type).
                            </div>
                            <field name="time_breakdown_ids" readonly="1">
                                <list>
                                    <field name="sequence"/>
                                    <field name="category_id"/>
                                    <field name="hours"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical Data">
                            <group>
                                <group string="Bit Data">
                                    <field name="bit_no"/>
                                    <field name="bit_size"/>
                                    <field name="bit_type"/>
                                    <field name="bit_ser_no"/>
                                    <field name="bit_jets"/>
                                </group>
                                <group string="Mud Data">
                                    <field name="mud_type"/>
                                    <field name="mud_wt"/>
                                    <field name="mud_ph"/>
                                    <field name="mud_pv"/>
                                    <field name="mud_yp"/>
                                </group>
                            </group>
                            <group>
                                <group string="Engineering Data">
                                    <field name="depth_in"/>
                                    <field name="depth_out"/>
                                    <field name="operation_hrs"/>
                                    <field name="string_wt"/>
                                    <field name="ann_vol"/>
                                    <field name="dc_wt"/>
                                    <field name="pressure"/>
                                    <field name="wt_on_bit"/>
                                    <field name="solids_pct"/>
                                    <field name="oil_pct"/>
                                </group>
                                <group string="Pump Data">
                                    <field name="pump_model"/>
                                    <field name="pump_no"/>
                                    <field name="pump_stroke"/>
                                    <field name="pump_liner_size"/>
                                    <field name="pump_spm"/>
                                </group>
                            </group>
                            <group string="Transport">
                                <group>
                                    <field name="transport_own"/>
                                    <field name="transport_rental"/>
                                    <field name="transport_toyota"/>
                                </group>
                                <group>
                                    <field name="transport_crane"/>
                                    <field name="transport_forklift"/>
                                    <field name="transport_truck"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_workover_daily_report_search" model="ir.ui.view">
        <field name="name">workover.daily.report.search</field>
        <field name="model">workover.daily.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="rig_id"/>
                <field name="well_id"/>
                <field name="operator_id"/>
                <field name="summary_type"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_rig" string="Rig" context="{'group_by': 'rig_id'}"/>
                    <filter name="group_well" string="Well" context="{'group_by': 'well_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'report_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_workover_daily_report" model="ir.actions.act_window">
        <field name="name">Daily Reports</field>
        <field name="res_model">workover.daily.report</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
