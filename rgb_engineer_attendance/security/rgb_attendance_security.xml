<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_rgb_attendance" model="ir.module.category">
        <field name="name">Engineer Attendance</field>
        <field name="description">Attendance sheets and approval.</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_rgb_attendance_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_rgb_attendance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Create and edit draft attendance sheets. No access to other apps unless granted separately.</field>
    </record>

    <record id="group_rgb_attendance_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="category_id" ref="module_category_rgb_attendance"/>
        <field name="implied_ids" eval="[(4, ref('group_rgb_attendance_user'))]"/>
    </record>

    <record id="group_rgb_attendance_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_rgb_attendance"/>
        <field name="implied_ids" eval="[(4, ref('group_rgb_attendance_approver'))]"/>
    </record>
</odoo>
