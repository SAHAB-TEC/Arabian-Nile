<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_contract_form_rgb_engineer_payroll" model="ir.ui.view">
        <field name="name">hr.contract.form.rgb.engineer.payroll</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='information']" position="after">
                <page string="Payroll" name="engineer_payroll">
                    <group>
                        <group>
                            <field name="daily_rate"/>
                            <field name="last_net_salary" readonly="1"/>
                            <field name="last_basic_salary" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="engineer_partner_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="engineer_salary_line_ids" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="month_name" string="Month"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="days_count"/>
                            <field name="daily_rate"/>
                            <field name="net_salary"/>
                            <field name="basic_salary"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
