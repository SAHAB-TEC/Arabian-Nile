    <record id="view_rgb_attendance_sheet_search" model="ir.ui.view">
        <field name="name">rgb.attendance.sheet.search</field>
        <field name="model">rgb.attendance.sheet</field>
        <field name="arch" type="xml">
            <search string="Attendance">
                <field name="name"/>
                <field name="engineer_id" string="Engineer"/>
                <field name="partner_company_id" string="Company"/>
                <field name="rig_id" string="Rig"/>
                <field name="well_id" string="Well"/>
                <field name="product_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_to_approve" string="To Approve" domain="[('state', '=', 'to_approve')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', 'in', ('approved', 'invoiced'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_engineer" string="Engineer" context="{'group_by': 'engineer_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'partner_company_id'}"/>
                    <filter name="group_rig" string="Rig" context="{'group_by': 'rig_id'}"/>
                    <filter name="group_period" string="Period" context="{'group_by': 'period_label'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rgb_attendance_sheet" model="ir.actions.act_window">
        <field name="name">Attendance Table</field>
        <field name="res_model">rgb.attendance.sheet</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rgb_attendance_sheet_search"/>
        <field name="context">{}</field>
    </record>

    <record id="action_rgb_attendance_export" model="ir.actions.server">
        <field name="name">Export Excel (CSV)</field>
        <field name="model_id" ref="model_rgb_attendance_sheet"/>
        <field name="binding_model_id" ref="model_rgb_attendance_sheet"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
action = env['rgb.attendance.export.wizard'].create({})
action = action.action_export_excel_csv()
        </field>
    </record>
</odoo>
