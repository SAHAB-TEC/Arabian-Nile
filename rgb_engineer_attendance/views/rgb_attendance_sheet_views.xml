<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_product_form_inherit_engineer_attendance" model="ir.ui.view">
        <field name="name">product.product.form.inherit.engineer.attendance</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="is_engineer_attendance_product"/>
            </xpath>
        </field>
    </record>
    <record id="view_partner_form_inherit_engineer" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.engineer</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_engineer"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_search_inherit_engineer" model="ir.ui.view">
        <field name="name">res.partner.search.inherit.engineer</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='supplier']" position="after">
                <filter name="filter_engineers" string="Engineers" domain="[('is_engineer', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_rgb_engineers" model="ir.actions.act_window">
        <field name="name">Engineers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_is_engineer': True}</field>
        <field name="domain">[('is_engineer', '=', True)]</field>
    </record>

    <record id="view_rgb_attendance_sheet_list" model="ir.ui.view">
        <field name="name">rgb.attendance.sheet.list</field>
        <field name="model">rgb.attendance.sheet</field>
        <field name="arch" type="xml">
            <list string="Attendance Table" decoration-muted="state == 'cancel'" decoration-success="state == 'invoiced'">
                <field name="name"/>
                <field name="engineer_id"/>
                <field name="well_id"/>
                <field name="rig_id"/>
                <field name="analytic_account_id"/>
                <field name="partner_company_id" string="Company"/>
                <field name="days_count" string="Number of Days"/>
                <field name="product_id"/>
                <field name="period_label" string="Period"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'to_approve'" decoration-success="state in ('approved', 'invoiced')"/>
            </list>
        </field>
    </record>

    <record id="view_rgb_attendance_sheet_form" model="ir.ui.view">
        <field name="name">rgb.attendance.sheet.form</field>
        <field name="model">rgb.attendance.sheet</field>
        <field name="arch" type="xml">
            <form string="Attendance Sheet">
                <header>
                    <button name="action_submit" string="Generate" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="state != 'to_approve'"
                            groups="rgb_engineer_attendance.group_rgb_attendance_approver"/>
                    <button name="action_view_invoice" string="Vendor Bill" type="object"
                            invisible="not invoice_id"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('to_approve', 'approved', 'cancel')"
                            groups="rgb_engineer_attendance.group_rgb_attendance_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('cancel', 'invoiced')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,approved,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="not invoice_id">
                            <field name="invoice_id" widget="statinfo" string="Vendor Bill"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="engineer_id" readonly="state != 'draft'"/>
                            <field name="partner_company_id" readonly="state != 'draft'"/>
                            <field name="well_id" readonly="state != 'draft'"/>
                            <field name="rig_id" readonly="state != 'draft'"/>
                            <field name="analytic_account_id" readonly="state != 'draft'"/>
                            <field name="product_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Period">
                            <field name="month" readonly="state != 'draft'"/>
                            <field name="year" readonly="state != 'draft'"/>
                            <field name="days_in_month" invisible="1"/>
                            <field name="days_count" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="approver_id" readonly="1" invisible="not approver_id"/>
                            <field name="approval_date" readonly="1" invisible="not approval_date"/>
