<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_delivery_ticket_note" model="ir.ui.view">
        <field name="name">stock.move.form.delivery.ticket.note</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom']" position="after">
                <field name="delivery_ticket_note"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_move_ticket_note" model="ir.ui.view">
        <field name="name">stock.picking.move.delivery.ticket.note</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']//field[@name='product_id']" position="after">
                <field name="delivery_ticket_note" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
