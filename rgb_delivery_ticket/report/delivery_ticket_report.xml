<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Separate report — does NOT replace stock Delivery Slip -->
    <record id="action_report_delivery_ticket" model="ir.actions.report">
        <field name="name">Delivery Ticket / أمر الحركة</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rgb_delivery_ticket.report_delivery_ticket</field>
        <field name="report_file">rgb_delivery_ticket.report_delivery_ticket</field>
        <field name="print_report_name">'Delivery_Ticket_%s' % (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
