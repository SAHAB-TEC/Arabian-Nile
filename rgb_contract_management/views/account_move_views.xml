<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_contract" model="ir.ui.view">
        <field name="name">account.move.form.contract</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contract_id"
                       domain="[('state', 'in', ('approved', 'in_progress', 'done'))]"
                       options="{'no_create': True}"/>
                <field name="contract_code" readonly="1" invisible="not contract_id"/>
                <field name="contract_type" invisible="1"/>
                <field name="contract_manual_exchange_rate" readonly="1"
                       invisible="not contract_id"/>
            </xpath>
            <xpath expr="//group[hasclass('oe_invoice_lines_tab')]" position="after">
                <group string="Payment Currency Split" invisible="not contract_id">
                    <field name="currency_split_percentage_total" readonly="1"
                           decoration-danger="currency_split_percentage_total != 100 and currency_split_percentage_total != 0"/>
                    <field name="currency_split_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="currency_id"/>
                            <field name="exchange_rate"/>
                            <field name="percentage"/>
                            <field name="amount" readonly="1"/>
                        </list>
                    </field>
                    <field name="dollar_percentage" invisible="1"/>
                    <field name="libya_dinar_percentage" invisible="1"/>
                    <field name="usd_amount" invisible="1"/>
                    <field name="lyd_amount" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
