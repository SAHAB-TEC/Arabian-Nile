<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_contract" model="ir.ui.view">
        <field name="name">account.move.form.contract</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contract_id"
                       domain="[('state', 'in', ('approved', 'in_progress', 'done'))]"
                       options="{'no_create': True}"/>
                <field name="contract_code" readonly="1" invisible="not contract_id"/>
                <field name="contract_type" invisible="1"/>
            </xpath>
            <xpath expr="//group[hasclass('oe_invoice_lines_tab')]" position="after">
                <group string="Currency Split" invisible="not contract_id">
                    <group>
                        <field name="dollar_percentage"/>
                        <field name="usd_amount" readonly="1"/>
                    </group>
                    <group>
                        <field name="libya_dinar_percentage"/>
                        <field name="lyd_amount" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
