<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Title above partner name in the top-right address column -->
    <template id="address_layout_rgb_invoice" inherit_id="web.address_layout">
        <xpath expr="//div[@name='address']/t[@t-esc='address or None']" position="before">
            <strong t-if="o and o._name == 'account.move' and o.is_sale_document(include_receipts=True)"
                    class="d-block mb-1">العميل:</strong>
            <strong t-elif="o and o._name == 'account.move' and o.is_purchase_document(include_receipts=True)"
                    class="d-block mb-1">المورد/الشركة:</strong>
        </xpath>
    </template>

    <template id="report_invoice_document_contract" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="o.contract_code" class="col" name="contract_code">
                <strong>Contract Code</strong>
                <div t-field="o.contract_code"/>
            </div>
        </xpath>
        <xpath expr="//tbody[hasclass('invoice_tbody')]" position="inside">
            <tr t-if="o.contract_id and (o.dollar_percentage or o.libya_dinar_percentage)"
                class="is-subtotal text-end">
                <td colspan="99">
                    <span t-if="o.dollar_percentage" style="margin-right: 16px;">
                        <strong>USD %</strong>
                        <span t-field="o.dollar_percentage"/>
                        —
                        <strong>USD Amount</strong>
                        <span t-field="o.usd_amount"/>
                    </span>
                    <span t-if="o.libya_dinar_percentage">
                        <strong>LYD %</strong>
                        <span t-field="o.libya_dinar_percentage"/>
                        —
                        <strong>LYD Amount</strong>
                        <span t-field="o.lyd_amount"/>
                    </span>
                </td>
            </tr>
        </xpath>
    </template>
</odoo>
