<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Title above partner name in the top-right address column -->
    <template id="address_layout_rgb_invoice" inherit_id="web.address_layout">
        <xpath expr="//div[@name='address']/t[@t-esc='address or None']" position="before">
            <strong t-if="o and o._name == 'account.move' and o.is_sale_document(include_receipts=True)"
                    class="d-block mb-1">العميل:</strong>
            <strong t-elif="o and o._name == 'account.move' and o.is_purchase_document(include_receipts=True)"
                    class="d-block mb-1">المورد/الشركة:</strong>
        </xpath>
    </template>

    <template id="report_invoice_document_contract" inherit_id="account.report_invoice_document">

        <xpath expr="//tbody[hasclass('invoice_tbody')]" position="inside">
            <tr t-if="o.contract_id and o.currency_split_ids"
                class="is-subtotal text-end">
                <td colspan="99">
                    <t t-foreach="o.currency_split_ids" t-as="split">
                        <span style="margin-right: 16px;">
                            <strong t-field="split.currency_id"/>
                            <strong> %</strong>
                            <span t-field="split.percentage"/>
                            —
                            <strong>Amount</strong>
                            <span t-field="split.amount"
                                  t-options="{'widget': 'monetary', 'display_currency': split.currency_id}"/>
                        </span>
                    </t>
                </td>
            </tr>
        </xpath>

        <!-- Vendor invoice: deliverer / receiver signatures at report footer -->
        <xpath expr="//div[@id='payment_term']" position="after">
            <div t-if="o.is_purchase_document(include_receipts=True)"
                 class="mt-5 avoid-page-break-inside"
                 name="vendor_invoice_signatures">
                <div class="row mt-4">
                    <div class="col-6 pe-4">
                        <div class="text-center fw-bold mb-3">المسلم / Deliverer</div>
                        <div class="mb-3">
                            <span>الاسم / Name:</span>
                            <span style="display:inline-block; min-width:70%; border-bottom:1px solid #000; margin-inline-start:6px;">&#160;</span>
                        </div>
                        <div class="mb-3">
                            <span>التوقيع / Signature:</span>
                            <span style="display:inline-block; min-width:60%; border-bottom:1px solid #000; margin-inline-start:6px;">&#160;</span>
                        </div>
                        <div>
                            <span>التاريخ / Date:</span>
                            <span style="display:inline-block; min-width:65%; border-bottom:1px solid #000; margin-inline-start:6px;">&#160;</span>
                        </div>
                    </div>
                    <div class="col-6 ps-4">
                        <div class="text-center fw-bold mb-3">المستلم / Receiver</div>
                        <div class="mb-3">
                            <span>الاسم / Name:</span>
                            <span style="display:inline-block; min-width:70%; border-bottom:1px solid #000; margin-inline-start:6px;">&#160;</span>
                        </div>
                        <div class="mb-3">
                            <span>التوقيع / Signature:</span>
                            <span style="display:inline-block; min-width:60%; border-bottom:1px solid #000; margin-inline-start:6px;">&#160;</span>
                        </div>
                        <div>
                            <span>التاريخ / Date:</span>
                            <span style="display:inline-block; min-width:65%; border-bottom:1px solid #000; margin-inline-start:6px;">&#160;</span>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
