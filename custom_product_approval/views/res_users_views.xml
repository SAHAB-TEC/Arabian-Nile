<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_approval_inherit" model="ir.ui.view">
        <field name="name">res.users.form.approval.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="Product Approval" name="product_approval_group">
                    <field name="has_product_approval_rights"
                           groups="base.group_system"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
