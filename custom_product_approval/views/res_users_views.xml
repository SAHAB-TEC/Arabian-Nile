<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_approval_inherit" model="ir.ui.view">
        <field name="name">res.users.form.approval.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- Added as its own notebook tab (rather than appended inside
                 the existing 'preferences' page) so it's always visible
                 in its own right, and doesn't depend on the exact
                 internal layout of the base Preferences tab. -->
            <xpath expr="//notebook" position="inside">
                <page string="Product Approval" name="product_approval">
                    <group>
                        <field name="has_product_approval_rights"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
