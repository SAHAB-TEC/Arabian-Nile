<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Standard quotation/order print stays available as-is.
         Light extras below still apply to the original report only.
         ============================================================ -->
    <template id="report_saleorder_document_sale_quotation_custom"
              inherit_id="sale.report_saleorder_document">

        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-if">doc.show_taxes</attribute>
        </xpath>
        <xpath expr="//td[@name='td_taxes']" position="attributes">
            <attribute name="t-if">doc.show_taxes</attribute>
        </xpath>

        <xpath expr="//t[@t-call='sale.document_tax_totals']" position="replace">
            <t t-if="doc.show_taxes" t-call="sale.document_tax_totals">
                <t t-set="tax_totals" t-value="doc.tax_totals"/>
                <t t-set="currency" t-value="doc.currency_id"/>
            </t>
            <t t-else="">
                <tr class="o_subtotal">
                    <td><strong>Total</strong></td>
                    <td class="text-end">
                        <span t-field="doc.amount_untaxed"
                              t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                    </td>
                </tr>
            </t>
        </xpath>

        <xpath expr="//p[@t-if='not is_html_empty(doc.payment_term_id.note)']" position="after">
            <div class="mt-3" name="quotation_commercial_terms">
                <p t-if="doc.abco_ref">
                    <strong>ABCO Ref.:</strong>
                    <span t-field="doc.abco_ref"/>
                </p>
                <p t-if="doc.customer_offer_ref">
                    <strong t-esc="doc.customer_ref_display_label"/>
                    <span t-field="doc.customer_offer_ref"/>
                </p>
                <p t-if="doc.offer_validity">
                    <strong>Offer Validity:</strong>
                    <span t-field="doc.offer_validity"/>
                    <t t-if="doc.offer_validity_date">
                        <span> (until </span>
                        <span t-field="doc.offer_validity_date"/>
                        <span>)</span>
                    </t>
                </p>
                <p t-if="doc.country_of_origin_ids">
                    <strong>Country of Origin:</strong>
                    <span t-esc="', '.join(doc.country_of_origin_ids.mapped('name'))"/>
                </p>
                <p t-if="doc.delivery_time_from or doc.delivery_time_to">
                    <strong>Delivery Time:</strong>
                    <t t-if="doc.delivery_time_from and doc.delivery_time_to">
                        <span t-esc="doc.delivery_time_from"/>
                        <span> to </span>
                        <span t-esc="doc.delivery_time_to"/>
                        <span> Weeks</span>
                    </t>
                    <t t-elif="doc.delivery_time_from">
                        <span>From </span>
                        <span t-esc="doc.delivery_time_from"/>
                        <span> Weeks</span>
                    </t>
                    <t t-else="">
                        <span>Up to </span>
                        <span t-esc="doc.delivery_time_to"/>
                        <span> Weeks</span>
                    </t>
                </p>
                <p t-if="doc.print_incoterm">
                    <strong>Incoterm:</strong>
                    <span t-field="doc.print_incoterm"/>
                </p>
                <p t-if="doc.print_payment or doc._get_abco_payment_print()">
                    <strong>Payment:</strong>
                    <span t-esc="doc._get_abco_payment_print()"/>
                </p>
            </div>
        </xpath>

        <xpath expr="//div[@name='signature']" position="after">
            <div t-if="doc.signatory_name" class="mt-4" name="quotation_signatory">
                <div class="offset-8">
                    <strong>For and on behalf of</strong>
                    <div t-field="doc.company_id.partner_id"/>
                    <div class="mt-3">
                        <strong>Authorized Signatory:</strong>
                        <span t-field="doc.signatory_name"/>
                    </div>
                    <div t-if="doc.signatory_title" t-esc="doc.signatory_title"/>
                </div>
            </div>
        </xpath>
    </template>

    <!-- ============================================================
         Shared ABCO front pages (title + letter), using external_layout
         ============================================================ -->
    <template id="report_abco_title_page">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="oe_structure"/>
                <div style="min-height: 18cm; display: flex; flex-direction: column; justify-content: center;">
                    <div class="text-center mb-5">
                        <h2 class="mb-4">
                            <t t-esc="offer_type_label"/>
                        </h2>
                        <div class="mt-4" style="font-size: 14px; line-height: 2;">
                            <div>
                                <strong>ABCO Ref.:</strong>
                                <span t-esc="doc.abco_ref or ''"/>
                            </div>
                            <div t-if="doc.customer_offer_ref">
                                <strong t-esc="doc.customer_ref_display_label"/>
                                <span t-esc="doc.customer_offer_ref"/>
                            </div>
                            <div>
                                <strong>Rev.:</strong>
                                <span t-esc="doc.abco_revision or ''"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_abco_letter_page">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="oe_structure"/>
                <div class="row mb-4">
                    <div class="col-6">
                        <div>
                            <strong>Date:</strong>
                            <span t-field="doc.date_order" t-options='{"widget": "date"}'/>
                        </div>
                        <div class="mt-3">
                            <strong>To:</strong>
                            <div t-esc="doc.cover_to or ''"/>
                            <div t-field="doc.partner_id"/>
                        </div>
                    </div>
                    <div class="col-6 text-end">
                        <div>
                            <strong>ABCO Ref.:</strong>
                            <span t-esc="doc.abco_ref or ''"/>
                        </div>
                        <div t-if="doc.customer_offer_ref">
                            <strong t-esc="doc.customer_ref_display_label"/>
                            <span t-esc="doc.customer_offer_ref"/>
                        </div>
                        <div>
                            <strong>Rev.:</strong>
                            <span t-esc="doc.abco_revision or ''"/>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <strong>Subject:</strong>
                    <span t-esc="doc.cover_subject or default_cover_subject"/>
                </div>

                <div class="mb-3">Dear Sir,</div>
                <div class="mb-4" style="white-space: pre-wrap;" t-esc="doc.cover_body or ''"/>

                <div class="mt-5">
                    <div>Regards</div>
                    <div class="mt-4 fw-bold" t-esc="doc.signatory_name or ''"/>
                    <div t-esc="doc.signatory_title or ''"/>
                </div>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <!-- ============================================================
         Commercial: primary inherit of original sale document
         ============================================================ -->
    <template id="report_abco_commercial_sale_document"
              inherit_id="sale.report_saleorder_document"
              primary="True">
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <span>Commercial Priced</span>
                <t t-if="doc.abco_ref">
                    <span> — </span>
                    <span t-field="doc.abco_ref"/>
                </t>
            </t>
        </xpath>
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="doc.abco_ref" class="col">
                <strong>ABCO Ref.</strong>
                <div t-field="doc.abco_ref"/>
            </div>
            <div t-if="doc.customer_offer_ref" class="col">
                <strong t-esc="doc.customer_ref_display_label"/>
                <div t-field="doc.customer_offer_ref"/>
            </div>
            <div t-if="doc.abco_revision" class="col">
                <strong>Rev.</strong>
                <div t-esc="doc.abco_revision"/>
            </div>
        </xpath>
    </template>

    <template id="report_abco_commercial_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="offer_type_label" t-value="'Commercial Priced'"/>
                <t t-set="default_cover_subject" t-value="'Commercial Priced Submission'"/>
                <!-- Page 1: title -->
                <t t-call="sale_quotation_custom.report_abco_title_page"/>
                <!-- Page 2: letter -->
                <t t-call="sale_quotation_custom.report_abco_letter_page"/>
                <!-- Page 3+: original sale layout (priced) -->
                <t t-call="sale_quotation_custom.report_abco_commercial_sale_document"
                   t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <!-- ============================================================
         Unpriced: primary inherit of original sale document
         ============================================================ -->
    <template id="report_abco_unpriced_sale_document"
              inherit_id="sale.report_saleorder_document"
              primary="True">
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <span>Technical Unpriced</span>
                <t t-if="doc.abco_ref">
                    <span> — </span>
                    <span t-field="doc.abco_ref"/>
                </t>
            </t>
        </xpath>
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="doc.abco_ref" class="col">
                <strong>ABCO Ref.</strong>
                <div t-field="doc.abco_ref"/>
            </div>
            <div t-if="doc.customer_offer_ref" class="col">
                <strong t-esc="doc.customer_ref_display_label"/>
                <div t-field="doc.customer_offer_ref"/>
            </div>
            <div t-if="doc.abco_revision" class="col">
                <strong>Rev.</strong>
                <div t-esc="doc.abco_revision"/>
            </div>
        </xpath>

        <!-- Hide money columns / totals -->
        <xpath expr="//td[@name='td_priceunit']" position="replace">
            <td name="td_priceunit" class="text-end text-nowrap">-</td>
        </xpath>
        <xpath expr="//td[@name='td_subtotal']" position="replace">
            <td t-if="not line.is_downpayment" name="td_subtotal" class="text-end o_price_total">-</td>
        </xpath>
        <xpath expr="//td[@name='td_section_subtotal']" position="replace">
            <td name="td_section_subtotal" colspan="99">
                <strong class="mr16">Subtotal</strong>
                <span>-</span>
            </td>
        </xpath>
        <xpath expr="//th[@name='th_discount']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//td[@t-if='display_discount']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//td[@name='td_taxes']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@id='total']" position="replace">
            <div id="total" class="row mt-n3" name="total">
                <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                    <table class="o_total_table table table-borderless">
                        <tr class="o_subtotal">
                            <td><strong>Total</strong></td>
                            <td class="text-end">-</td>
                        </tr>
                    </table>
                </div>
            </div>
        </xpath>
    </template>

    <template id="report_abco_unpriced_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="offer_type_label" t-value="'Technical Unpriced'"/>
                <t t-set="default_cover_subject" t-value="'Technical Unpriced Submission'"/>
                <!-- Page 1: title -->
                <t t-call="sale_quotation_custom.report_abco_title_page"/>
                <!-- Page 2: letter -->
                <t t-call="sale_quotation_custom.report_abco_letter_page"/>
                <!-- Page 3+: original sale layout (unpriced) -->
                <t t-call="sale_quotation_custom.report_abco_unpriced_sale_document"
                   t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <record id="action_report_abco_commercial" model="ir.actions.report">
        <field name="name">ABCO Commercial Offer</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_quotation_custom.report_abco_commercial_document</field>
        <field name="report_file">sale_quotation_custom.report_abco_commercial_document</field>
        <field name="print_report_name">'ABCO-Commercial-%s' % (object.abco_ref or object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_abco_unpriced" model="ir.actions.report">
        <field name="name">ABCO Unpriced Offer</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_quotation_custom.report_abco_unpriced_document</field>
        <field name="report_file">sale_quotation_custom.report_abco_unpriced_document</field>
        <field name="print_report_name">'ABCO-Unpriced-%s' % (object.abco_ref or object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
