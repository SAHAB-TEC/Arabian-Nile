<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_invoice_approval_request" model="mail.template">
        <field name="name">Invoice Approval Request</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="subject">Invoice approval required: {{ object.name or object.display_name }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Hello,</p>
                <p>
                    Your approval is required for invoice
                    <strong><t t-out="object.display_name"/></strong>
                    at stage
                    <strong><t t-out="object.current_approval_stage"/></strong>.
                </p>
                <p>
                    Competent department:
                    <t t-out="object.competent_department_id.name or ''"/>
                </p>
            </div>
        </field>
    </record>
</odoo>
