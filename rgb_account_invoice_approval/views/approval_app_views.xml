<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_approver_readonly" model="ir.ui.view">
        <field name="name">account.move.form.approver.readonly</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Invoice Approval" create="false" edit="false" delete="false">
                <header>
                    <button name="action_approve_invoice"
                            string="Approve Invoice"
                            type="object"
                            class="oe_highlight"
                            invisible="not can_current_user_approve"/>
                    <button name="action_open_reject_wizard"
                            string="Reject"
                            type="object"
                            invisible="not can_current_user_approve"/>
                    <field name="approval_state" widget="statusbar"
                           statusbar_visible="to_submit,waiting_department,waiting_final,approved"/>
                </header>
                <sheet>
                    <field name="approval_required" invisible="1"/>
                    <field name="can_current_user_approve" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="move_type" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="competent_department_id" readonly="1"/>
                            <field name="invoice_date" readonly="1"/>
                            <field name="invoice_date_due" readonly="1"/>
                            <field name="ref" readonly="1"/>
                        </group>
                        <group>
                            <field name="current_approval_stage" readonly="1"/>
                            <field name="current_approval_group_id" readonly="1"/>
                            <field name="department_approver_user_id" readonly="1"/>
                            <field name="approval_progress" readonly="1"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoice Lines" name="invoice_lines">
                            <field name="invoice_line_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="price_subtotal"/>
                                </list>
                            </field>
                        </page>
                        <page string="Approval Path" name="approval_path">
                            <field name="approval_line_ids" readonly="1">
                                <list>
                                    <field name="sequence"/>
                                    <field name="stage_name"/>
                                    <field name="group_id"/>
                                    <field name="state"/>
                                    <field name="approved_by"/>
                                    <field name="approved_date"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_move_list_approver" model="ir.ui.view">
        <field name="name">account.move.list.approver</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Pending Invoice Approvals" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="move_type"/>
                <field name="partner_id"/>
                <field name="competent_department_id"/>
                <field name="invoice_date"/>
                <field name="current_approval_stage"/>
                <field name="amount_total"/>
                <field name="currency_id"/>
                <field name="approval_state"
                       widget="badge"
                       decoration-warning="approval_state == 'waiting_department'"
                       decoration-primary="approval_state == 'waiting_final'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_invoice_approval_pending" model="ir.actions.act_window">
        <field name="name">My Pending Approvals</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_move_list_approver')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_move_form_approver_readonly')}),
        ]"/>
        <field name="domain">[
            ('approval_state', 'in', ('waiting_department', 'waiting_final')),
            ('state', '=', 'draft'),
        ]</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
