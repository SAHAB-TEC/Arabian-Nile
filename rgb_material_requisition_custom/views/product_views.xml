<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_rgb_analytic" model="ir.ui.view">
        <field name="name">product.template.form.rgb.analytic</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_storable']" position="after">
                <field name="rgb_analytic_account_id"
                       options="{'no_create': True}"
                       groups="rgb_material_requisition_custom.group_product_analytic_manager"/>
            </xpath>
        </field>
    </record>

    <!-- Visible read-only for users without edit permission -->
    <record id="view_product_template_form_rgb_analytic_readonly" model="ir.ui.view">
        <field name="name">product.template.form.rgb.analytic.readonly</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_storable']" position="after">
                <field name="rgb_analytic_account_id"
                       readonly="1"
                       groups="!rgb_material_requisition_custom.group_product_analytic_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
