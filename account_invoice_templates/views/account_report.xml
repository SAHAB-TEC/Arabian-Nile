    <template id="report_invoice_document_gulf_transport" inherit_id="account.report_invoice_document" primary="True">
        <xpath expr="//th[@name='th_discount']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <xpath expr="//td[@name='td_discount']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <xpath expr="//td[@name='td_taxes']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>

        <xpath expr="//th[@name='th_subtotal']/span" position="replace">
            <span>LYD</span>
        </xpath>

        <xpath expr="//th[@name='th_quantity']/span" position="replace">
            <span>Weight</span>
        </xpath>
        <xpath expr="//th[@name='th_description']/span" position="replace">
            <span>Payload Type</span>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="before">
            <th style="border: 1px solid #000; text-align: center; width: 3%;">No</th>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="after">
            
            <th style="border: 1px solid #000;">Date</th>
            
            
            <th style="border: 1px solid #000;">D.T No.</th>
        </xpath>

        <xpath expr="//tbody" position="before">
            <t t-set="line_no" t-value="0"/>
        </xpath>

        <xpath expr="//td[@name='account_invoice_line_name']" position="replace">
            <td name="account_invoice_line_name">
                <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}" dir="auto"/>
            </td>
        </xpath>

        <xpath expr="//td[@name='account_invoice_line_name']" position="before">
            <t t-set="line_no" t-value="line_no + 1"/>
            <td style="border: 1px solid #000; text-align: center;"><span t-out="line_no"/></td>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="after">
            
            <td style="border: 1px solid #000;">
                <span t-if="line.ait_transport_service_date" t-field="line.ait_transport_service_date"/>
                <span t-if="not line.ait_transport_service_date and o.invoice_date" t-field="o.invoice_date"/>
            </td>
            
            
            <td style="border: 1px solid #000;"><span t-field="line.ait_transport_dt_no"/></td>
        </xpath>

        <xpath expr="//td[@name='td_subtotal']" position="replace">
            <td name="td_subtotal" class="text-end o_price_total">
                <span class="text-nowrap" t-field="line.price_total"/>
            </td>
        </xpath>

        <xpath expr="//tbody[hasclass('invoice_tbody')]" position="inside">
            <tr class="is-subtotal text-end">
                <td colspan="99">
                    <strong class="mr16">Subtotal (incl. tax)</strong>
                    <span t-field="o.ait_transport_subtotal" class="text-nowrap"
                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                </td>
            </tr>
            <tr class="is-subtotal text-end">
                <td colspan="99">
                    <strong class="mr16">Desert charge 15%</strong>
                    <span t-field="o.ait_transport_desert_charge" class="text-nowrap"
                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                </td>
            </tr>
            <tr class="is-subtotal text-end">
                <td colspan="99">
                    <strong class="mr16">Grand total</strong>
                    <span t-field="o.ait_transport_grand_total" class="text-nowrap"
                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                </td>
            </tr>
        </xpath>
    </template>
</odoo>