<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_rgb_pob" model="ir.module.category">
        <field name="name">POB (Personnel on Board)</field>
        <field name="description">Personnel on Board travel permits</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_pob_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_rgb_pob"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can create and follow POB requests.</field>
    </record>

    <record id="group_pob_operations" model="res.groups">
        <field name="name">Operations</field>
        <field name="category_id" ref="module_category_rgb_pob"/>
        <field name="implied_ids" eval="[(4, ref('group_pob_user'))]"/>
        <field name="comment">Can approve Operations stage and extension requests.</field>
    </record>

    <record id="group_pob_hse" model="res.groups">
        <field name="name">HSE / Rig</field>
        <field name="category_id" ref="module_category_rgb_pob"/>
        <field name="implied_ids" eval="[(4, ref('group_pob_user'))]"/>
        <field name="comment">Can approve HSE / Rig stage.</field>
    </record>

    <record id="group_pob_supervisor" model="res.groups">
        <field name="name">Site Supervisor</field>
        <field name="category_id" ref="module_category_rgb_pob"/>
        <field name="implied_ids" eval="[(4, ref('group_pob_user'))]"/>
        <field name="comment">Can request stay extensions for active POB permits.</field>
    </record>

    <record id="group_pob_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_rgb_pob"/>
        <field name="implied_ids" eval="[(4, ref('group_pob_operations')), (4, ref('group_pob_hse')), (4, ref('group_pob_supervisor'))]"/>
        <field name="comment">Full POB access including configuration and extensions.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_pob_request_user_own" model="ir.rule">
        <field name="name">POB request: user sees own</field>
        <field name="model_id" ref="model_pob_request"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_pob_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_pob_request_approver_all" model="ir.rule">
        <field name="name">POB request: operations/hse/manager see all</field>
        <field name="model_id" ref="model_pob_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pob_operations')), (4, ref('group_pob_hse')), (4, ref('group_pob_supervisor')), (4, ref('group_pob_manager'))]"/>
    </record>

    <record id="rule_pob_request_company" model="ir.rule">
        <field name="name">POB request: multi-company</field>
        <field name="model_id" ref="model_pob_request"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_pob_extension_company" model="ir.rule">
        <field name="name">POB extension: multi-company</field>
        <field name="model_id" ref="model_pob_extension"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
