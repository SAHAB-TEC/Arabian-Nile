<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pob_extension_wizard_form" model="ir.ui.view">
        <field name="name">pob.extension.wizard.form</field>
        <field name="model">pob.extension.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Extension">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="employee_id"/>
                    <field name="date_end"/>
                    <field name="extension_days"/>
                    <field name="reason" placeholder="Reason for extension (required)"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Submit Extension" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
