<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pob_rig_list" model="ir.ui.view">
        <field name="name">pob.rig.list</field>
        <field name="model">pob.rig</field>
        <field name="arch" type="xml">
            <list string="Rigs">
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="well_id"/>
                <field name="partner_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_pob_rig_form" model="ir.ui.view">
        <field name="name">pob.rig.form</field>
        <field name="model">pob.rig</field>
        <field name="arch" type="xml">
            <form string="Rig">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="well_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pob_rig_search" model="ir.ui.view">
        <field name="name">pob.rig.search</field>
        <field name="model">pob.rig</field>
        <field name="arch" type="xml">
            <search string="Search Rigs">
                <field name="name"/>
                <field name="code"/>
                <field name="well_id"/>
                <field name="partner_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="groupby_well" string="Well" context="{'group_by': 'well_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pob_rig" model="ir.actions.act_window">
        <field name="name">Rigs</field>
        <field name="res_model">pob.rig</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pob_rig_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a rig / location</p>
        </field>
    </record>
</odoo>
