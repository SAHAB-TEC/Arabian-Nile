<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_rgb_analytic_invisible" model="ir.module.category">
        <field name="name">Analytic Invisible</field>
        <field name="sequence">57</field>
    </record>

    <record id="group_analytic_invisible_manager" model="res.groups">
        <field name="name">Manage Analytic Invisible</field>
        <field name="category_id" ref="module_category_rgb_analytic_invisible"/>
        <field name="implied_ids" eval="[(4, ref('analytic.group_analytic_accounting'))]"/>
        <field name="comment">
            Can set the Invisible flag on analytic accounts and analytic plans.
        </field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
