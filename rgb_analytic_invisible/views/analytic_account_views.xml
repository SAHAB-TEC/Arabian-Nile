<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_account_form_rgb_invisible" model="ir.ui.view">
        <field name="name">account.analytic.account.form.rgb.invisible</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='web_ribbon']" position="after">
                <widget name="web_ribbon" title="Invisible" bg_color="text-bg-warning"
                        invisible="not rgb_invisible"/>
            </xpath>
            <xpath expr="//field[@name='code']" position="after">
                <field name="rgb_invisible"
                         groups="rgb_analytic_invisible.group_analytic_invisible_manager"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_analytic_account_list_rgb_invisible" model="ir.ui.view">
        <field name="name">account.analytic.account.list.rgb.invisible</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="rgb_invisible" optional="show" widget="boolean_toggle"
                         groups="rgb_analytic_invisible.group_analytic_invisible_manager"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_analytic_account_search_rgb_invisible" model="ir.ui.view">
        <field name="name">account.analytic.account.search.rgb.invisible</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <filter string="Invisible" name="rgb_invisible"
                        domain="[('rgb_invisible', '=', True)]"
                        groups="rgb_analytic_invisible.group_analytic_invisible_manager"/>
                <filter string="Visible" name="rgb_visible"
                        domain="[('rgb_invisible', '=', False)]"
                        groups="rgb_analytic_invisible.group_analytic_invisible_manager"/>
            </xpath>
        </field>
    </record>

    <!-- Keep invisible records manageable from Analytic Accounts config menus -->
    <record id="analytic.action_account_analytic_account_form" model="ir.actions.act_window">
        <field name="context">{'search_default_active': 1, 'rgb_show_invisible_analytic': True}</field>
    </record>

    <record id="analytic.action_analytic_account_form" model="ir.actions.act_window">
        <field name="context">{'search_default_active': 1, 'rgb_show_invisible_analytic': True}</field>
    </record>
</odoo>
