<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_project_form_rgb_ncr" model="ir.ui.view">
        <field name="name">construction.project.form.rgb.ncr</field>
        <field name="model">construction.project</field>
        <field name="inherit_id" ref="sdlc_construction_management.view_construction_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_ncr" type="object"
                        class="oe_stat_button" icon="fa-exclamation-triangle">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="ncr_count"/>
                        </span>
                        <span class="o_stat_text">NCR</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='warehouse_id']" position="after">
                <field name="analytic_account_id"/>
                <field name="ncr_open_count" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
