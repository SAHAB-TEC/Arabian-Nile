<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Convert Quality Checks into a parent menu -->
    <record id="sdlc_construction_management.menu_construction_quality_checks" model="ir.ui.menu">
        <field name="action" eval="False"/>
    </record>

    <menuitem id="menu_construction_quality_check_items"
              name="Quality Checks"
              parent="sdlc_construction_management.menu_construction_quality_checks"
              action="sdlc_construction_management.action_construction_quality_check"
              sequence="10"/>

    <menuitem id="menu_rgb_ncr_quality"
              name="NCR Reports"
              parent="sdlc_construction_management.menu_construction_quality_checks"
              action="action_rgb_ncr"
              sequence="20"/>

    <!-- Under Operations for field use -->
    <menuitem id="menu_rgb_ncr_operations"
              name="NCR Reports"
              parent="sdlc_construction_management.menu_construction_operations"
              action="action_rgb_ncr"
              sequence="20"/>
</odoo>
